<UserControl x:Class="NotchWindows.App.Views.VolumeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="8,4" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LabelText" Grid.Column="0" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Height="4" CornerRadius="2" Background="#33FFFFFF" Margin="12,0" VerticalAlignment="Center">
            <Border x:Name="Fill" CornerRadius="2" Background="White" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="FillScale" ScaleX="0"/>
                </Border.RenderTransform>
            </Border>
        </Border>
        <TextBlock x:Name="PercentText" Grid.Column="2" Foreground="#B3FFFFFF" FontSize="13" VerticalAlignment="Center"/>
    </Grid>
</UserControl>

<UserControl x:Class="NotchWindows.App.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="8,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="ThumbnailImage" Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0"
               Stretch="UniformToFill" Visibility="Collapsed"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ArtistText" Foreground="#B3FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PlayPauseButton" Focusable="False" IsTabStop="False" Width="32" Height="32"
                    Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"
                    Content="&#x25B6;" Click="OnPlayPauseClick"/>
            <Button x:Name="NextButton" Focusable="False" IsTabStop="False" Width="32" Height="32"
                    Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"
                    Content="&#x23ED;" Click="OnNextClick"/>
        </StackPanel>
    </Grid>
</UserControl>

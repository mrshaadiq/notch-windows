<UserControl x:Class="NotchWindows.App.Views.BatteryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <StackPanel Orientation="Horizontal" Margin="8,4" VerticalAlignment="Center">
        <TextBlock x:Name="StateText" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="PercentText" Foreground="#B3FFFFFF" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
